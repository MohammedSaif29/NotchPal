// Tells Cloudflare how to host the NotchPal website: it serves the files in website/ as they are.
// This has nothing to do with building the Mac app.
{
  "name": "notchpal",
  "compatibility_date": "2026-11-01",
  // Only the real address. The workers.dev address and preview links stay off, because they
  // carry the Cloudflare account's name.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "notchpal.mohammedsaif.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./website",
    "not_found_handling": "404-page"
  }
}
